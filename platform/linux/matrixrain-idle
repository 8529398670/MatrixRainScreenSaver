#!/bin/sh
# matrixrain-idle - start the rain after N idle minutes on GNOME (Wayland or X11).
#
# GNOME has no plug-in slot for screensavers, so this watches GNOME's own
# idle timer and launches `matrixrain --fullscreen` when you've been away.
# Moving the mouse or pressing a key closes the rain as usual.
# This does NOT replace the lock screen: GNOME's own blank/lock settings
# still apply (set "Screen Blank" longer than the minutes here).
#
#   matrixrain-idle [MINUTES]     default 10
set -u
MINUTES=${1:-10}
LIMIT=$((MINUTES * 60 * 1000))
RAIN=$(command -v matrixrain || echo /usr/libexec/xscreensaver/matrixrain)

idle_ms() {
    gdbus call --session --dest org.gnome.Mutter.IdleMonitor \
        --object-path /org/gnome/Mutter/IdleMonitor/Core \
        --method org.gnome.Mutter.IdleMonitor.GetIdletime 2>/dev/null |
        sed -n 's/.*uint64 \([0-9][0-9]*\).*/\1/p'
}

while sleep 5; do
    idle=$(idle_ms)
    [ -n "$idle" ] || continue
    if [ "$idle" -ge "$LIMIT" ]; then
        "$RAIN" --fullscreen   # blocks until input closes it; idle time then resets
    fi
done
