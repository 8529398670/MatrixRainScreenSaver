#include <windows.h>

/* Per-monitor DPI awareness + common controls v6 (themed sliders). */
1 24 "app.manifest"

/* String 1 is the name the Screen Saver Settings dropdown shows. */
STRINGTABLE
BEGIN
    1 "Matrix Rain"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 5,0,0,0
 PRODUCTVERSION 5,0,0,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Matrix Rain"
            VALUE "ProductName", "Matrix Rain screensaver"
            VALUE "FileVersion", "5.0"
            VALUE "OriginalFilename", "MatrixRain.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
